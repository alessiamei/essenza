<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --ivory: #f5f0e8;
  --ivory-dark: #ede6d8;
  --cream: #faf7f2;
  --black: #0a0908;
  --charcoal: #1c1a18;
  --warm-gray: #3d3830;
  --mid-gray: #7a7268;
  --light-gray: #b8b0a4;
  --accent: #8b6f47;
  --accent-light: #c4a882;
  --accent-dark: #5c4830;
  --burgundy: #4a1e2a;
}

body {
  background: var(--black);
  color: var(--ivory);
  font-family: 'Montserrat', sans-serif;
  font-weight: 300;
  overflow-x: hidden;
}

/* HERO */
.hero {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  position: relative;
}

.hero-left {
  padding: 80px 60px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-right: 0.5px solid #2a2520;
  position: relative;
  z-index: 2;
}

.hero-right {
  position: relative;
  overflow: hidden;
}

.hero-right img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.7) contrast(1.1);
  display: block;
}

.hero-right::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to right, var(--black) 0%, transparent 30%);
}

.eyebrow {
  font-family: 'Montserrat', sans-serif;
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 5px;
  color: var(--accent-light);
  text-transform: uppercase;
}

.hero-content { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 60px 0; }

.hero-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(52px, 6vw, 80px);
  font-weight: 400;
  line-height: 1.05;
  color: var(--ivory);
  letter-spacing: -1px;
  margin-bottom: 8px;
}

.hero-title em {
  font-style: italic;
  color: var(--accent-light);
}

.hero-rule {
  width: 60px;
  height: 0.5px;
  background: var(--accent);
  margin: 32px 0;
}

.hero-taglines {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 48px;
}

.hero-tagline {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-size: 15px;
  color: var(--light-gray);
  line-height: 1.5;
}

.hero-tagline strong {
  color: var(--ivory);
  font-style: normal;
  font-weight: 400;
}

.hero-cta {
  display: inline-block;
  padding: 14px 36px;
  border: 0.5px solid var(--accent);
  color: var(--accent-light);
  font-family: 'Montserrat', sans-serif;
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 4px;
  text-transform: uppercase;
  text-decoration: none;
  transition: all 0.4s;
  align-self: flex-start;
}

.hero-cta:hover {
  background: var(--accent);
  color: var(--ivory);
}

.hero-bottom {
  display: flex;
  align-items: center;
  gap: 20px;
}

.hero-scroll {
  font-size: 9px;
  letter-spacing: 3px;
  color: var(--warm-gray);
  text-transform: uppercase;
}

/* QUOTE SECTION */
.quote-section {
  padding: 100px 80px;
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 80px;
  align-items: center;
  border-bottom: 0.5px solid #1e1c1a;
}

.quote-label {
  font-size: 9px;
  letter-spacing: 4px;
  color: var(--accent);
  text-transform: uppercase;
  writing-mode: vertical-rl;
  transform: rotate(180deg);
}

.quote-text {
  font-family: 'Playfair Display', serif;
  font-size: clamp(22px, 2.5vw, 32px);
  font-weight: 400;
  font-style: italic;
  color: var(--ivory);
  line-height: 1.5;
}

.quote-text span {
  color: var(--accent-light);
}

/* IMAGE GRID */
.image-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  grid-template-rows: 280px 280px;
  gap: 1px;
  background: #1a1816;
}

.img-cell {
  overflow: hidden;
  position: relative;
}

.img-cell img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.75) saturate(0.8);
  transition: transform 0.6s ease, filter 0.6s ease;
  display: block;
}

.img-cell:hover img {
  transform: scale(1.04);
  filter: brightness(0.85) saturate(0.9);
}

.img-cell.tall {
  grid-row: span 2;
}

/* FOR WHO */
.for-section {
  padding: 100px 80px;
  border-bottom: 0.5px solid #1e1c1a;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-bottom: 64px;
}

.section-label {
  font-size: 9px;
  letter-spacing: 5px;
  color: var(--accent);
  text-transform: uppercase;
  white-space: nowrap;
}

.section-line {
  flex: 1;
  height: 0.5px;
  background: #2a2520;
}

.section-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(28px, 3vw, 42px);
  font-weight: 400;
  color: var(--ivory);
  margin-bottom: 48px;
}

.for-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: #1e1c1a;
}

.for-item {
  background: var(--black);
  padding: 40px 36px;
  transition: background 0.3s;
}

.for-item:hover { background: #0f0e0c; }

.for-num {
  font-family: 'Playfair Display', serif;
  font-size: 48px;
  font-weight: 400;
  font-style: italic;
  color: #1e1c1a;
  margin-bottom: 20px;
  line-height: 1;
}

.for-title {
  font-family: 'Playfair Display', serif;
  font-size: 18px;
  font-weight: 400;
  color: var(--ivory);
  margin-bottom: 12px;
  font-style: italic;
}

.for-desc {
  font-size: 11px;
  color: var(--mid-gray);
  line-height: 1.8;
  letter-spacing: 0.5px;
}

/* PACKAGES */
.packages-section {
  padding: 100px 80px;
  border-bottom: 0.5px solid #1e1c1a;
}

.packages-intro {
  max-width: 560px;
  margin-bottom: 80px;
}

.packages-intro p {
  font-family: 'Playfair Display', serif;
  font-size: 16px;
  font-style: italic;
  color: var(--light-gray);
  line-height: 1.8;
}

.packages-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: #1e1c1a;
}

.pkg {
  background: var(--black);
  padding: 48px 40px;
  position: relative;
  display: flex;
  flex-direction: column;
}

.pkg.featured {
  background: #0e0c0a;
}

.pkg-badge {
