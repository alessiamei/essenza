  color: var(--ivory);
  font-size: 8px;
  letter-spacing: 3px;
  padding: 5px 20px;
  text-transform: uppercase;
  font-weight: 500;
  white-space: nowrap;
}

.pkg-tier {
  font-size: 9px;
  letter-spacing: 4px;
  color: var(--accent);
  text-transform: uppercase;
  margin-bottom: 24px;
}

.pkg-name {
  font-family: 'Playfair Display', serif;
  font-size: 32px;
  font-weight: 400;
  font-style: italic;
  color: var(--ivory);
  margin-bottom: 8px;
}

.pkg-price {
  font-family: 'Montserrat', sans-serif;
  font-size: 44px;
  font-weight: 300;
  color: var(--accent-light);
  letter-spacing: -1px;
  margin-bottom: 4px;
}

.pkg-price-note {
  font-size: 10px;
  color: var(--warm-gray);
  letter-spacing: 2px;
  margin-bottom: 40px;
}

.pkg-divider {
  height: 0.5px;
  background: #1e1c1a;
  margin-bottom: 32px;
}

.pkg-features {
  list-style: none;
  flex: 1;
  margin-bottom: 48px;
}

.pkg-features li {
  font-size: 11px;
  color: var(--mid-gray);
  padding: 10px 0;
  border-bottom: 0.5px solid #151310;
  display: flex;
  gap: 12px;
  align-items: flex-start;
  line-height: 1.6;
  letter-spacing: 0.3px;
}

.pkg-features li::before {
  content: '—';
  color: var(--accent);
  flex-shrink: 0;
  font-size: 10px;
}

.pkg-features li.off { color: #2a2820; }
.pkg-features li.off::before { color: #1a1816; }

.pkg-btn {
  display: block;
  padding: 16px;
  border: 0.5px solid #2a2520;
  color: var(--warm-gray);
  font-family: 'Montserrat', sans-serif;
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 4px;
  text-transform: uppercase;
  text-align: center;
  text-decoration: none;
  transition: all 0.4s;
  cursor: pointer;
  background: transparent;
  width: 100%;
}

.pkg-btn:hover, .pkg-btn.featured-btn {
  border-color: var(--accent);
  color: var(--accent-light);
}

.pkg-btn.featured-btn:hover {
  background: var(--accent);
  color: var(--ivory);
}

/* FOOTER */
.footer {
  padding: 60px 80px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 0.5px solid #1e1c1a;
}

.footer-brand {
  font-family: 'Playfair Display', serif;
  font-size: 22px;
  font-weight: 400;
  font-style: italic;
  color: var(--light-gray);
}

.footer-info {
  font-size: 9px;
  letter-spacing: 3px;
  color: var(--warm-gray);
  text-transform: uppercase;
  text-align: right;
}

@media (max-width: 768px) {
  .hero { grid-template-columns: 1fr; }
  .hero-right { height: 300px; }
  .hero-left { padding: 60px 32px; }
  .quote-section { grid-template-columns: 1fr; padding: 60px 32px; gap: 32px; }
  .quote-label { writing-mode: horizontal-tb; transform: none; }
  .image-grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
  .img-cell.tall { grid-row: span 1; }
  .for-section, .packages-section { padding: 60px 32px; }
  .for-grid { grid-template-columns: 1fr; }
  .packages-grid { grid-template-columns: 1fr; }
  .footer { flex-direction: column; gap: 24px; padding: 40px 32px; text-align: center; }
  .footer-info { text-align: center; }
}
</style>
</head>
